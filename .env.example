# Atlas configuration — copy to .env and adjust. Everything below is read from the environment;
# nothing sensitive is hardcoded in the source. Unset values fall back to dev-friendly defaults.

# ----------------------------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------------------------
# Marks the process as production: enables Secure cookies, serves the SPA on one port, blocks the
# demo seed, and selects the data/prod folder. Set this in 1panel/your process manager.
NODE_ENV=production

# HTTP port the Bun server listens on. Your reverse proxy (nginx/1panel) forwards to this.
PORT=3000

# ----------------------------------------------------------------------------------------------
# Data location  (all article content lives in SQLite — back up this file)
# ----------------------------------------------------------------------------------------------
# Recommended in production: an ABSOLUTE, persistent directory OUTSIDE the code dir so redeploys
# never wipe data. The DB file becomes <ATLAS_DATA_DIR>/<prod|dev>/atlas.sqlite.
# ATLAS_DATA_DIR=/opt/atlas/data
#
# Or pin the exact file (highest precedence; overrides ATLAS_DATA_DIR and the dev/prod split):
# DATABASE_URL=/opt/atlas/data/atlas.sqlite
#
# With neither set: dev uses apps/api/data/dev/atlas.sqlite, prod uses apps/api/data/prod/atlas.sqlite.

# ----------------------------------------------------------------------------------------------
# First admin  (used only by `bun run --filter @atlas/api db:create-admin`)
# ----------------------------------------------------------------------------------------------
# Password is REQUIRED (min 8 chars) and never hardcoded. Email/name are not secrets.
ATLAS_ADMIN_EMAIL=maybe@atlas.team
ATLAS_ADMIN_NAME=Maybe
ATLAS_ADMIN_PASSWORD=Maybe0047!

# ----------------------------------------------------------------------------------------------
# Networking / proxy
# ----------------------------------------------------------------------------------------------
# Cross-origin browser origins (comma-separated). In the single-port layout the SPA and API share
# one origin, so CORS is never triggered — leave this UNSET in production. Only needed if the
# frontend is served from a different origin than the API.
# ATLAS_CORS_ORIGIN=https://atlas.example.com

# Set to 1 if behind a reverse proxy, so login rate-limiting keys on the real client IP
# (X-Forwarded-For / X-Real-IP). Recommended true behind nginx/1panel.
ATLAS_TRUST_PROXY=1

# Force the SPA+API single-port static serving even outside production (debugging the prod layout).
# ATLAS_SERVE_STATIC=1

# Force Secure cookies outside production (e.g. testing HTTPS locally). Auto-on when NODE_ENV=production.
# ATLAS_COOKIE_SECURE=1

# ----------------------------------------------------------------------------------------------
# Login rate limiting (optional)
# ----------------------------------------------------------------------------------------------
# ATLAS_LOGIN_RATE_LIMIT_MAX_FAILURES=5
# ATLAS_LOGIN_RATE_LIMIT_WINDOW_MS=600000

# ----------------------------------------------------------------------------------------------
# Content-Security-Policy (optional override)
# ----------------------------------------------------------------------------------------------
# The built-in default is a strict same-origin policy plus the Google Fonts hosts. Override the
# whole policy here only if you must (e.g. an uploaded HTML doc needs inline scripts — add
# 'unsafe-inline'/'unsafe-eval' to script-src, understanding the risk).
# ATLAS_CSP=default-src 'self'; ...

# ----------------------------------------------------------------------------------------------
# DANGER: allow the demo seed to run in production (wipes ALL data). Leave unset.
# ----------------------------------------------------------------------------------------------
# ATLAS_ALLOW_SEED=true
