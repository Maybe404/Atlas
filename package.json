{
  "name": "atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @atlas/api db:migrate && bun run --filter '*' dev",
    "dev:web": "bun run --filter @atlas/web dev",
    "dev:api": "bun run --filter @atlas/api db:migrate && bun run --filter @atlas/api dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "fmt": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.3.14"
}
